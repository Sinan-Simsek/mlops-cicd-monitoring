# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored (never commit real keys). Two uses:
#   1. Local runs:  the app reads these via python-dotenv (database.py, llm_ep.py).
#   2. Kubernetes:  kubectl create secret generic app-secret --from-env-file=.env
#      (only the LLM_* / *_API_KEY keys are consumed by the Deployment; all are optional)

# ── Database ────────────────────────────────────────────────────────────
# Local run: point at a reachable Postgres (or your own instance).
# In Kubernetes this value is overridden by ml-prediction-deployment.yaml,
# which targets the in-cluster `postgres` Service.
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://train:Ankara06@localhost:5432/traindb

# ── LLM backend for /llm/chat ───────────────────────────────────────────
# Selects the provider. Everything below is optional: without a key the app
# still boots and only /llm/chat returns 503.
#   google_genai (default) -> needs GOOGLE_API_KEY     (get: https://aistudio.google.com/app/apikey)
#   openrouter             -> needs OPENROUTER_API_KEY (get: https://openrouter.ai/keys)
LLM_PROVIDER=google_genai

# Gemini (used when LLM_PROVIDER=google_genai)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
